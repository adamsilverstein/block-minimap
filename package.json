{
  "name": "minimap",
  "version": "1.0.1",
  "description": "",
  "main": "minimap.js",
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode=production",
    "build:dev": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode=development --devtool cheap-source-map --output-pathinfo",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --watch --mode=development --devtool cheap-module-eval-source-map --output-pathinfo",
    "format-js": "wp-scripts format-js",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test": "npm run test:e2e"
  },
  "author": "",
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/cli": "^7.7.0",
    "@babel/core": "^7.7.2",
    "@babel/preset-env": "^7.7.1",
    "@babel/preset-react": "^7.7.0",
    "@playwright/test": "^1.62.1",
    "@wordpress/components": "^8.3.2",
    "@wordpress/compose": "^3.7.2",
    "@wordpress/data": "^4.9.2",
    "@wordpress/e2e-test-utils-playwright": "^1.53.0",
    "@wordpress/edit-post": "^3.8.5",
    "@wordpress/env": "^10.39.0",
    "@wordpress/plugins": "^2.7.2",
    "@wordpress/scripts": "^5.1.0",
    "babel-eslint": "^10.0.3",
    "babel-loader": "^8.0.6",
    "babel-plugin-lodash": "^3.3.4",
    "core-js": "^3.4.0",
    "css-loader": "^3.2.0",
    "dir-glob": "^3.0.1",
    "dom-minimap": "^1.7.5",
    "eslint": "^6.6.0",
    "eslint-loader": "^3.0.2",
    "eslint-plugin-react": "^7.16.0",
    "prettier": "^1.19.1",
    "react": "^16.11.0",
    "react-dom": "^16.11.0",
    "react-minimap": "^0.7.4",
    "style-loader": "^1.0.0",
    "webpack": "^4.41.2",
    "webpack-cli": "^3.3.10",
    "webpackbar": "^4.0.0"
  },
  "globals": {
    "wp": "off"
  }
}
